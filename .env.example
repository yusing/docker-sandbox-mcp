# Docker Cloud Sandboxes authentication (set EITHER DOCKER_ACCESS_TOKEN OR DOCKER_USERNAME + DOCKER_PAT)
DOCKER_USERNAME=your-docker-username
DOCKER_PAT=dckr_pat_xxxxxxxxxxxxxxxxxxxx
# DOCKER_ACCESS_TOKEN=

# MCP endpoint protection (recommended for Cloud Run / remote clients)
MCP_BEARER_TOKEN=change-me-to-a-strong-random-secret
PUBLIC_URL=https://your-cloud-run-service.run.app
# OAUTH_ISSUER=https://accounts.google.com

# Transport: "http" (default, Cloud Run Streamable HTTP) or "stdio" (local CLI)
MCP_TRANSPORT=http
PORT=8080
