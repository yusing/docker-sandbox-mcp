# Docker Cloud Sandboxes authentication (set EITHER DOCKER_ACCESS_TOKEN OR DOCKER_USERNAME + DOCKER_PAT)
DOCKER_USERNAME=your-docker-username
DOCKER_PAT=dckr_pat_xxxxxxxxxxxxxxxxxxxx
# DOCKER_ACCESS_TOKEN=

# Public HTTPS base URL of this MCP server (used for RFC 9728 OAuth metadata)
PUBLIC_URL=https://sbx-mcp.yourdomain.com

# Google Cloud OAuth 2.0 / OIDC verification (works for both JWT ID tokens & opaque ya29.* access tokens)
OAUTH_ISSUER=https://accounts.google.com
OAUTH_AUDIENCE=1234567890-xxxxxxxx.apps.googleusercontent.com
# Restrict access to your own Google account(s) (comma-separated)
OAUTH_ALLOWED_EMAILS=you@gmail.com
# OAUTH_ALLOWED_SUBS=
# OAUTH_REQUIRED_SCOPES=
# OAUTH_JWKS_URI=
# OAUTH_TOKENINFO_URI=

# Optional static Bearer token fallback (useful for local scripts / CI)
# MCP_BEARER_TOKEN=change-me-to-a-strong-random-secret

# Transport: "http" (default, Streamable HTTP) or "stdio" (local CLI)
MCP_TRANSPORT=http
PORT=8080
