# Docker Cloud Sandboxes authentication (set EITHER DOCKER_ACCESS_TOKEN OR DOCKER_USERNAME + DOCKER_PAT)
DOCKER_USERNAME=your-docker-username
DOCKER_PAT=dckr_pat_xxxxxxxxxxxxxxxxxxxx
# DOCKER_ACCESS_TOKEN=

# Public HTTPS base URL of this MCP server (used for RFC 9728 OAuth metadata)
PUBLIC_URL=https://your-cloud-run-service.run.app

# OAuth 2.0 / OIDC JWT verification (recommended for Gemini Web Connected Apps)
OAUTH_ISSUER=https://your-idp.example.com
OAUTH_AUDIENCE=https://your-cloud-run-service.run.app/mcp
# OAUTH_JWKS_URI=https://your-idp.example.com/.well-known/jwks.json
# Restrict access to your own account(s) (comma-separated)
OAUTH_ALLOWED_EMAILS=you@example.com
# OAUTH_ALLOWED_SUBS=
# OAUTH_REQUIRED_SCOPES=sandboxes:write

# Optional static Bearer token fallback (useful for local scripts / CI)
# MCP_BEARER_TOKEN=change-me-to-a-strong-random-secret

# Transport: "http" (default, Streamable HTTP) or "stdio" (local CLI)
MCP_TRANSPORT=http
PORT=8080
