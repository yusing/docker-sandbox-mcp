# Docker Cloud Sandboxes authentication (set EITHER DOCKER_ACCESS_TOKEN OR DOCKER_USERNAME + DOCKER_PAT)
DOCKER_USERNAME=your-docker-username
DOCKER_PAT=dckr_pat_xxxxxxxxxxxxxxxxxxxx
# DOCKER_ACCESS_TOKEN=

# Public HTTPS base URL of this MCP server (used for OAuth proxy & RFC 9728 metadata)
PUBLIC_URL=https://docker-sbx-mcp.yourdomain.com

# Google OAuth 2.0 Web Client credentials for FastMCP's OAuth 2.1 proxy
# Authorized redirect URI in Google Cloud Console: https://<your-domain>/oauth/callback
GOOGLE_OAUTH_CLIENT_ID=1234567890-xxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx

# Restrict access to verified Google account(s) (comma-separated)
ALLOWED_EMAILS=you@gmail.com

# Optional: override allowed OAuth client redirect URI glob patterns (defaults to Gemini + localhost)
# ALLOWED_CLIENT_REDIRECT_URIS=https://oauth-redirect.googleusercontent.com/r/*,http://localhost:*

# Optional: explicit secret for signing FastMCP JWTs and encrypting stored tokens
# (defaults to deterministic keys derived from GOOGLE_OAUTH_CLIENT_SECRET)
# FASTMCP_JWT_SIGNING_KEY=

# Optional static Bearer token fallback (useful for local scripts / CI)
# MCP_BEARER_TOKEN=change-me-to-a-strong-random-secret

# Transport: "http" (default, Streamable HTTP) or "stdio" (local CLI)
MCP_TRANSPORT=http
PORT=8080
