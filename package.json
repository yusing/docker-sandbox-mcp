{
  "name": "docker-sandbox-mcp",
  "version": "0.1.0",
  "description": "Cloud Run-ready Model Context Protocol (MCP) server for creating, managing, and working inside Docker Cloud Sandboxes (@docker/sandboxes), designed for Gemini Web and remote AI agents.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@docker/sandboxes": "^0.53.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "license": "MIT"
}
